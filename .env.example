# Cadence environment configuration.
# Copy to `.env` and adjust as needed. Never commit real secrets.

# Base URL the Axios client points at. With MSW enabled this is intercepted
# in-browser, so any same-origin prefix works. Point this at a real API to
# migrate off the mock backend.
VITE_API_BASE_URL=/api

# Enable the Mock Service Worker backend ("true" | "false").
# Defaults to true (including production/Vercel) so login works without a real API.
# Set to false once VITE_API_BASE_URL points at a live backend.
VITE_ENABLE_MOCKS=true
